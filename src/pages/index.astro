---
import SiteLayout from '../layouts/SiteLayout.astro'
import today from '../data/today.json'

const states = [
  { name: '梁工', range: '< 50%', image: '/artwork/gong.png' },
  { name: '梁总', range: '50% — 70%', image: '/artwork/zong.png' },
  { name: '梁神', range: '70% — 85%', image: '/artwork/shen.png' },
  { name: '梁圣', range: '85% — 95%', image: '/artwork/sheng.png' },
  { name: '梁祖', range: '≥ 95%', image: '/artwork/zu.png' },
]

const stateMap: Record<string, { name: string; image: string }> = {
  waiting: { name: '待开梁', image: '/artwork/waiting.png' },
  liang_gong: { name: '梁工', image: '/artwork/gong.png' },
  liang_zong: { name: '梁总', image: '/artwork/zong.png' },
  liang_shen: { name: '梁神', image: '/artwork/shen.png' },
  liang_sheng: { name: '梁圣', image: '/artwork/sheng.png' },
  liang_zu: { name: '梁祖', image: '/artwork/zu.png' },
}
const currentState = stateMap[today.liangzi_state] ?? stateMap.waiting
const ratioText = today.up_ratio === null
  ? '--'
  : `${(Math.floor(today.up_ratio * 100 * 1_000_000) / 1_000_000).toFixed(6)}%`
const incenseText = new Intl.NumberFormat('zh-CN').format(today.total_incense)
const socialImage = `/media/social/today.png?v=${today.business_date}-${today.snapshot_version}`
---

<SiteLayout
  title="梁相"
  description="长在 DeepSeek Harness 里的社区插件。每天一道梁案，用香火投下夯或拉，众香汇成梁位，共同显出今日梁相。"
  pageClass="home-page"
>
  <section class="home-hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">DeepSeek Harness 社区插件</p>
        <h1>今天的梁子，<span>夯上去还是拉下来？</span></h1>
        <p class="hero-lede">每天一道梁案。你在 DSH 里写代码、跑会话，Token 凝成香火；一炷一票，所有人的选择汇成梁位，决定今天的梁子。</p>
        <div class="hero-actions">
          <button class="button button-primary" type="button" data-deploy-open>安装梁相</button>
          <a class="button button-ghost" href="#how">看懂玩法</a>
        </div>
        <div class="hero-facts" aria-label="梁相特点">
          <span>新香客备 10 炷</span>
          <span>点按上香</span>
          <span>长按倾炉</span>
        </div>
      </div>

      <div class="install-terminal" data-reveal>
        <div class="terminal-bar">
          <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>装进 DeepSeek Harness</span>
          <button type="button" data-copy-target="hero-cli" hidden>复制</button>
        </div>
        <div class="install-tabs" role="tablist" aria-label="安装方式">
          <button id="install-tab-market" type="button" role="tab" aria-selected="true" aria-controls="install-market" data-install-tab="market">Desktop · 推荐</button>
          <button id="install-tab-cli" type="button" role="tab" aria-selected="false" aria-controls="install-cli" data-install-tab="cli" tabindex="-1">Cmd / Web</button>
        </div>
        <div class="terminal-panel" id="install-market" role="tabpanel" aria-labelledby="install-tab-market" data-install-panel="market">
          <ol class="install-steps">
            <li>打开 <strong>插件 → 添加插件</strong></li>
            <li>输入完整包名 <code>dsh-liangxiang</code></li>
            <li>点击安装，完成后<strong>立即启用</strong></li>
          </ol>
        </div>
        <div class="terminal-panel" id="install-cli" role="tabpanel" aria-labelledby="install-tab-cli" data-install-panel="cli" hidden>
          <span class="prompt" aria-hidden="true">$</span>
          <code id="hero-cli">dsh plugin --profile web add dsh-liangxiang</code>
        </div>
        <p>页面边缘出现「今日梁相」即可开始。<a href="/guide/">首次使用、安装和升级说明 →</a></p>
      </div>
    </div>

  </section>

  <section class="today-share-section" aria-labelledby="today-share-title">
    <div class="shell today-share-layout">
      <div class="today-share-copy" data-reveal>
        <p class="eyebrow">今日梁子分享卡 · {today.business_date}</p>
        <h2 id="today-share-title">今天，梁子显为「{currentState.name}」。</h2>
        <p class="today-share-case">{today.case_title}</p>
        <dl class="today-share-metrics">
          <div><dt>梁位</dt><dd>{ratioText}</dd></div>
          <div><dt>三界香火</dt><dd>{incenseText} 炷</dd></div>
          <div><dt>当前显相</dt><dd>{currentState.name}</dd></div>
        </dl>
        <div class="today-share-actions">
          <a class="button button-ghost" href={socialImage} target="_blank">查看分享卡</a>
          <button class="button button-primary" type="button" data-share-today data-social-image={socialImage}>分享今日梁相</button>
        </div>
        <span class="share-status" data-share-status aria-live="polite"></span>
      </div>
      <a class="today-share-card" href={socialImage} target="_blank" data-reveal aria-label="打开今日梁相高清分享卡">
        <img src={socialImage} alt={`今日梁相分享卡：${currentState.name}，梁位 ${ratioText}`} width="2400" height="1260" />
      </a>
    </div>
  </section>

  <section class="product-section" id="how">
    <div class="shell">
      <div class="section-intro split-intro" data-reveal>
        <div><p class="eyebrow">写代码，也写今日梁相</p><h2>不离开 DSH，顺手上一炷香。</h2></div>
        <p>输入与输出 Token 按模型折成香火。香火环告诉你还剩多少，以及下一炷走到哪里；点一下投一炷，长按按限额批量上香。</p>
      </div>

      <figure class="product-frame" data-reveal>
        <div class="window-bar"><span><i></i><i></i><i></i></span><small>梁相主界面</small><em>2160 × 2160 实机录屏</em></div>
        <video autoplay muted loop playsinline preload="metadata" poster="/media/product/liangxiang-main-2k.jpg" aria-label="梁相在 DeepSeek Harness 中的操作演示">
          <source src="/media/product/liangxiang-vote-2k.mp4" type="video/mp4" />
        </video>
      </figure>

      <div class="flow-grid" data-reveal>
        <article><span>01</span><strong>凝香</strong><p>Pro 类 ×1，Flash 类与其他模型 ×0.5。默认每 50,000 当量一炷。</p></article>
        <article><span>02</span><strong>上香</strong><p>一炷一票，只能夯或拉。</p></article>
        <article><span>03</span><strong>显相</strong><p>众香汇成梁位，梁子依势变化。</p></article>
        <article><span>04</span><strong>入祠</strong><p>每日结案，再汇成周梁与月梁。</p></article>
      </div>
    </div>
  </section>

  <section class="states-section">
    <div class="shell">
      <div class="section-intro centered-intro" data-reveal>
        <p class="eyebrow">一条梁位，五种显相</p>
        <h2>从梁工，一路夯到梁祖。</h2>
        <p>中央梁子只看社区夯率。门槛越高，显相越离谱。</p>
      </div>
      <div class="state-line" data-reveal>
        {states.map((state, index) => (
          <article>
            <span class="state-index">0{index + 1}</span>
            <img src={state.image} alt={`${state.name}形相`} loading="lazy" width="256" height="256" />
            <strong>{state.name}</strong>
            <small>{state.range}</small>
          </article>
        ))}
      </div>
      <p class="state-note" data-reveal>零票时显示「待开梁」；第一炷投下后进入五档显相。</p>
    </div>
  </section>

  <section class="archive-section" id="liangci">
    <div class="shell archive-layout">
      <div class="archive-copy" data-reveal>
        <p class="eyebrow">梁祠 · 只读编年</p>
        <h2>今天有结果，日后有来处。</h2>
        <p>每天结案后，日梁收入梁祠。原始夯拉票数继续汇成周梁和月梁，今日进行中永远不会被提前定论。</p>
        <div class="archive-tags"><span>日梁</span><span>周梁</span><span>月梁</span></div>
      </div>
      <figure class="archive-frame" data-reveal>
        <video autoplay muted loop playsinline preload="metadata" poster="/media/product/liangxiang-liangci-2k.jpg" aria-label="梁祠日历打开演示">
          <source src="/media/product/liangxiang-liangci-2k.mp4" type="video/mp4" />
        </video>
      </figure>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell final-cta-inner" data-reveal>
      <div><p class="eyebrow">今日开梁</p><h2>众香成势，梁子显相。</h2><p>装进 DeepSeek Harness，领十炷见面香。</p></div>
      <div class="final-actions"><button class="button button-primary" type="button" data-deploy-open>查看安装方式</button><a class="button button-ghost" href="https://github.com/liang-today/dsh-liangxiang">查看源码 ↗</a></div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: '梁相', alternateName: 'liangxiang',
    applicationCategory: 'DeveloperApplication', operatingSystem: 'Windows, macOS, Linux',
    description: '长在 DeepSeek Harness 里的社区插件。每天一道梁案，用香火投下夯或拉。',
    url: 'https://liang.today', codeRepository: 'https://github.com/liang-today/dsh-liangxiang',
    softwareVersion: '1.1.6', license: 'https://opensource.org/license/mit',
  })} />

  <script>
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((video) => video.pause())
    }

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-install-tab]')]
    const panels = [...document.querySelectorAll<HTMLElement>('[data-install-panel]')]
    const copyButton = document.querySelector<HTMLButtonElement>('.terminal-bar [data-copy-target]')
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const target = tab.dataset.installTab
        for (const item of tabs) {
          item.setAttribute('aria-selected', String(item === tab))
          item.tabIndex = item === tab ? 0 : -1
        }
        for (const panel of panels) panel.hidden = panel.dataset.installPanel !== target
        if (copyButton) {
          copyButton.hidden = target !== 'cli'
          copyButton.dataset.copyTarget = 'hero-cli'
        }
      })
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return
        event.preventDefault()
        const index = tabs.indexOf(tab)
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length
        tabs[next]?.click()
        tabs[next]?.focus()
      })
    }

    const shareButton = document.querySelector<HTMLButtonElement>('[data-share-today]')
    const shareStatus = document.querySelector<HTMLElement>('[data-share-status]')
    shareButton?.addEventListener('click', async () => {
      const shareData = { title: '今日梁相', text: '众香成势，梁子显相。看看今日社区梁相。', url: location.origin }
      try {
        const imageUrl = new URL(shareButton.dataset.socialImage ?? '/media/social/today.png', location.origin)
        if (navigator.share && navigator.canShare) {
          const response = await fetch(imageUrl)
          const card = new File([await response.blob()], '今日梁相.png', { type: 'image/png' })
          if (navigator.canShare({ files: [card] })) {
            await navigator.share({ title: shareData.title, text: shareData.text, files: [card] })
            return
          }
        }
        if (navigator.share) await navigator.share(shareData)
        else {
          await navigator.clipboard.writeText(location.origin)
          if (shareStatus) shareStatus.textContent = '链接已复制'
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return
        if (shareStatus) shareStatus.textContent = '请复制 liang.today 分享'
      }
    })
  </script>
</SiteLayout>
