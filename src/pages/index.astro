---
import SiteLayout from '../layouts/SiteLayout.astro'
import today from '../data/today.json'

const states = [
  { name: '梁工', range: '< 50%', image: '/artwork/gong.png' },
  { name: '梁总', range: '50% – 70%', image: '/artwork/zong.png' },
  { name: '梁神', range: '70% – 85%', image: '/artwork/shen.png' },
  { name: '梁圣', range: '85% – 95%', image: '/artwork/sheng.png' },
  { name: '梁祖', range: '≥ 95%', image: '/artwork/zu.png' },
]

const rules = [
  ['二', '只选夯或拉', '没有中立或第三选项；两边共用同一份个人香火。'],
  ['一', '一炷就是一票', '一次被接受的选择只烧一炷，不设方向倍率。'],
  ['位', '梁位决定梁子', '中央梁子只看全局夯率，个人进度不能改变显相。'],
  ['零', '零票待开梁', '没有投票时显示“--”，不制造 50:50 的假均势。'],
]

const stateMap: Record<string, { name: string; image: string }> = {
  waiting: { name: '待开梁', image: '/artwork/waiting.png' },
  liang_gong: { name: '梁工', image: '/artwork/gong.png' },
  liang_zong: { name: '梁总', image: '/artwork/zong.png' },
  liang_shen: { name: '梁神', image: '/artwork/shen.png' },
  liang_sheng: { name: '梁圣', image: '/artwork/sheng.png' },
  liang_zu: { name: '梁祖', image: '/artwork/zu.png' },
}
const currentState = stateMap[today.liangzi_state] ?? stateMap.waiting
const ratioText = today.up_ratio === null
  ? '--'
  : `${(Math.floor(today.up_ratio * 100 * 1_000_000) / 1_000_000).toFixed(6)}%`
const socialImage = `/media/social/today.png?v=${today.business_date}-${today.snapshot_version}`
---

<SiteLayout
  title="梁相"
  description="用 DeepSeek Harness 凝聚香火，投下一炷夯或拉；众香汇成梁位，共同显出今日梁相。"
  pageClass="home-page"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">DeepSeek Harness 社区玩法 · v0.6.0 RC</p>
        <h1>众香成势，<span>梁子显相。</span></h1>
        <p class="hero-lede">每天一道梁案。使用 DeepSeek Harness 凝成香火，投下一炷“夯”或“拉”；众人的选择汇成梁位，决定今天的梁子。</p>
        <div class="button-row">
          <a class="button button-primary" href="#play">看懂玩法</a>
          <a class="button" href="/guide/">安装梁相</a>
          <a class="button button-quiet" href="https://github.com/NiYa193/dsh-liang-meter">查看源码 ↗</a>
        </div>
        <div class="hero-proof" aria-label="产品要点">
          <span>Input + Output Token</span><span>一炷一票</span><span>日终入梁祠</span>
        </div>
      </div>

      <div class="demo-stage">
        <div class="demo-panel" data-liang-demo>
          <div class="demo-kicker"><span>今日梁案</span><span class="live-dot">零票演示</span></div>
          <p class="demo-case">DeepSeek Harness 是夯还是拉？</p>
          <div class="demo-core">
            <div class="demo-flank demo-flank-left">今日凝香<strong>0 炷</strong></div>
            <div class="incense-ring" aria-hidden="true"><div class="demo-avatar-wrap"><img class="demo-avatar" data-demo-avatar src="/artwork/waiting.png" alt="" /></div></div>
            <div class="demo-flank demo-flank-right">下一炷<strong>50K</strong></div>
            <div class="ratio-pill" aria-live="polite">梁位 <span data-demo-ratio>--</span> → <span data-demo-state>待开梁</span></div>
          </div>
          <div class="demo-votes" aria-label="梁相网页演示按钮">
            <button class="demo-vote" type="button" data-vote="up">夯 · 升梁</button>
            <button class="demo-vote" type="button" data-vote="down">拉 · 降梁</button>
          </div>
          <div class="demo-stats">
            <span>三界香火<strong data-demo-total>0</strong></span>
            <span>五行香客<strong data-demo-users>0</strong></span>
            <button class="demo-reset" type="button" data-demo-reset>重置</button>
          </div>
        </div>
        <p class="demo-caption">这是从零票开始的本地演示，不会写入社区今日梁案。</p>
      </div>

      <aside class="today-snapshot" aria-label="今日社区快照">
        <img src={currentState.image} alt={`${currentState.name}形相`} width="112" height="112" />
        <div class="today-snapshot-copy">
          <span>今日社区快照 · {today.business_date}</span>
          <strong>{currentState.name}<small>梁位 {ratioText}</small></strong>
          <p>{today.case_title} · {today.total_incense} 炷香火 · {today.unique_voters} 位香客</p>
        </div>
        <div class="today-actions">
          <a class="button" href={socialImage} target="_blank">查看社交卡</a>
          <button class="button button-primary" type="button" data-share-today data-social-image={socialImage}>分享今日梁相</button>
          <span class="share-status" data-share-status aria-live="polite"></span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="play">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">一天的梁相</p><h2>从一次对话，到一页编年。</h2>
        <p>玩法只有四步：凝香、表态、显相、入祠。个人香火与全局梁位在画面上相遇，在账本中始终分开。</p>
      </div>
      <div class="steps-grid" data-reveal>
        <article class="step-card"><div class="step-index"><span>01 · 凝香</span></div><h3>使用 DSH</h3><p>Input + Output Token 按模型权重折算，默认每 50,000 Pro 当量凝成一炷。</p></article>
        <article class="step-card"><div class="step-index"><span>02 · 表态</span></div><h3>投下一炷</h3><p>面对今日梁案，选择“夯 · 升梁”或“拉 · 降梁”。一次只烧一炷。</p></article>
        <article class="step-card"><div class="step-index"><span>03 · 显相</span></div><h3>众香成梁位</h3><p>社区夯率就是梁位；跨过固定门槛时，梁子随同一份快照显相。</p></article>
        <article class="step-card"><div class="step-index"><span>04 · 入祠</span></div><h3>日终封存</h3><p>今日只显示进行中；业务日结束后，结果成为不可改写的日梁。</p></article>
      </div>
      <div class="ritual-strip" data-reveal>
        <div><strong>三界香火</strong><span>今天已经接受的全部票数</span></div>
        <div><strong>五行香客</strong><span>至少成功投过一票的独立安装</span></div>
        <div><strong>上达天听</strong><span>主动核对社区最新权威快照</span></div>
      </div>
    </div>
  </section>

  <section class="section section-quiet" id="rules" aria-labelledby="states-title">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">显相与约束</p><h2 id="states-title">玩笑归玩笑，规则必须认真。</h2>
        <p>零票时是待开梁；有票后，梁子只按全局夯率跨过 50 / 70 / 85 / 95% 四道门槛。</p>
      </div>
      <div class="state-rail" data-reveal>
        {states.map((state) => <article class="state-card"><img src={state.image} alt={`${state.name}形相`} loading="lazy" width="256" height="256" /><strong>{state.name}</strong><small>{state.range}</small></article>)}
      </div>
      <div class="waiting-note" data-reveal><img src="/artwork/waiting.png" alt="" width="54" height="54" /><span><strong>零票例外：待开梁</strong>不是第六档，只是今日尚无人投香时的占位。</span></div>
      <div class="rules-grid compact-rules">
        {rules.map(([mark, title, text]) => <article class="rule" data-reveal><span class="rule-mark" aria-hidden="true">{mark}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}
      </div>
      <div class="notice" data-reveal><strong>信任边界：</strong>当前是社区软信任玩法。梁位不是实名人数、民意调查，也不代表梁文锋本人立场。</div>
    </div>
  </section>

  <section class="section" id="liangci">
    <div class="shell">
      <div class="liangci-heading" data-reveal>
        <div><p class="eyebrow">梁祠 · 只读编年</p><h2>克制的梁祠，不是古风游戏。</h2></div>
        <div><p>今日不提前下结论。业务日结束后，原始夯拉票数封存为日梁，再按票数加权汇成周梁与月梁。</p><div class="archive-pills"><span>日梁</span><span>周梁</span><span>月梁</span><span>今日进行中</span></div></div>
      </div>
      <figure class="liangci-frame" data-reveal><img src="/media/liangci-visual-spec.png" alt="梁祠月历界面示意，包含日梁、周梁、月梁和今日进行中状态" loading="lazy" width="1600" height="1100" /></figure>
    </div>
  </section>

  <section class="section section-quiet">
    <div class="shell cta-band" data-reveal>
      <div><p class="eyebrow">今日开梁</p><h2>把梁相装进 DeepSeek Harness。</h2><p>正式 Release 发布后可直接安装；现在也可以从源码启动独立开发环境。</p></div>
      <div class="button-row"><a class="button button-primary" href="/guide/">打开部署指南</a><a class="button" href="/privacy/">先看隐私边界</a></div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: '梁相', alternateName: 'liangxiang',
    applicationCategory: 'DeveloperApplication', operatingSystem: 'Windows, macOS, Linux',
    description: '用 DeepSeek Harness 凝聚香火，投下一炷夯或拉，共同显出今日梁相。',
    url: 'https://liang.today', codeRepository: 'https://github.com/NiYa193/dsh-liang-meter',
    softwareVersion: '0.6.0', license: 'https://opensource.org/license/mit',
  })} />

  <script>
    const panel = document.querySelector<HTMLElement>('[data-liang-demo]')
    if (panel) {
      const stateTable = [
        { min: 0.95, name: '梁祖', image: '/artwork/zu.png' },
        { min: 0.85, name: '梁圣', image: '/artwork/sheng.png' },
        { min: 0.70, name: '梁神', image: '/artwork/shen.png' },
        { min: 0.50, name: '梁总', image: '/artwork/zong.png' },
        { min: 0, name: '梁工', image: '/artwork/gong.png' },
      ]
      let up = 0
      let down = 0
      const ratioNode = panel.querySelector<HTMLElement>('[data-demo-ratio]')
      const stateNode = panel.querySelector<HTMLElement>('[data-demo-state]')
      const totalNode = panel.querySelector<HTMLElement>('[data-demo-total]')
      const usersNode = panel.querySelector<HTMLElement>('[data-demo-users]')
      const avatar = panel.querySelector<HTMLImageElement>('[data-demo-avatar]')
      const update = (animate = true) => {
        const total = up + down
        const ratio = total === 0 ? null : up / total
        const state = ratio === null ? { name: '待开梁', image: '/artwork/waiting.png' } : (stateTable.find((item) => ratio >= item.min) ?? stateTable[stateTable.length - 1])
        if (ratioNode) ratioNode.textContent = ratio === null ? '--' : `${(Math.floor(ratio * 100 * 1_000_000) / 1_000_000).toFixed(6)}%`
        if (stateNode) stateNode.textContent = state.name
        if (totalNode) totalNode.textContent = String(total)
        if (usersNode) usersNode.textContent = total === 0 ? '0' : '1'
        if (avatar) { avatar.src = state.image; avatar.alt = `${state.name}形相` }
        if (animate) { panel.classList.remove('is-voting'); void panel.offsetWidth; panel.classList.add('is-voting'); setTimeout(() => panel.classList.remove('is-voting'), 320) }
      }
      panel.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((button) => button.addEventListener('click', () => { if (button.dataset.vote === 'up') up += 1; else down += 1; update() }))
      panel.querySelector<HTMLButtonElement>('[data-demo-reset]')?.addEventListener('click', () => { up = 0; down = 0; update(false) })
    }

    const shareButton = document.querySelector<HTMLButtonElement>('[data-share-today]')
    const shareStatus = document.querySelector<HTMLElement>('[data-share-status]')
    shareButton?.addEventListener('click', async () => {
      const shareData = { title: '今日梁相', text: '众香成势，梁子显相。看看今日社区梁相。', url: location.origin }
      try {
        const imageUrl = new URL(shareButton.dataset.socialImage ?? '/media/social/today.png', location.origin)
        if (navigator.share && navigator.canShare) {
          const response = await fetch(imageUrl)
          const card = new File([await response.blob()], '今日梁相.png', { type: 'image/png' })
          if (navigator.canShare({ files: [card] })) {
            await navigator.share({ title: shareData.title, text: shareData.text, files: [card] })
            return
          }
        }
        if (navigator.share) await navigator.share(shareData)
        else { await navigator.clipboard.writeText(location.origin); if (shareStatus) shareStatus.textContent = '链接已复制' }
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return
        if (shareStatus) shareStatus.textContent = '请复制 liang.today 分享'
      }
    })
  </script>
</SiteLayout>
