---
import today from '../data/today.json'

const labels: Record<string, string> = {
  waiting: '待开梁',
  liang_gong: '梁工',
  liang_zong: '梁总',
  liang_shen: '梁神',
  liang_sheng: '梁圣',
  liang_zu: '梁祖',
}
const artwork: Record<string, string> = {
  waiting: '/artwork/waiting.png',
  liang_gong: '/artwork/gong.png',
  liang_zong: '/artwork/zong.png',
  liang_shen: '/artwork/shen.png',
  liang_sheng: '/artwork/sheng.png',
  liang_zu: '/artwork/zu.png',
}
const name = labels[today.liangzi_state] ?? labels.waiting
const image = artwork[today.liangzi_state] ?? artwork.waiting
const ratio = today.up_ratio === null ? '--' : `${(Math.floor(today.up_ratio * 100 * 1_000_000) / 1_000_000).toFixed(6)}%`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>今日梁相社交卡</title>
    <style>
      @font-face {
        font-family: "Liangxiang YaHei";
        font-style: normal;
        font-weight: 400;
        font-display: block;
        src: local("Microsoft YaHei"), local("Microsoft YaHei UI"), local("微软雅黑");
      }
      @font-face {
        font-family: "Liangxiang YaHei";
        font-style: normal;
        font-weight: 700;
        font-display: block;
        src: local("Microsoft YaHei Bold"), local("Microsoft YaHei UI Bold"), local("微软雅黑 Bold"), local("Microsoft YaHei"), local("微软雅黑");
      }
      * { box-sizing: border-box; }
      astro-dev-toolbar { display: none !important; }
      html, body { width: 100%; height: 100%; margin: 0; }
      body {
        min-width: 1200px;
        overflow: hidden;
        color: #1f2329;
        background: #e9eae5;
        font-family: "Liangxiang YaHei", "Microsoft YaHei", "微软雅黑", "Noto Sans SC", sans-serif;
        font-weight: 700;
      }
      .card {
        position: relative;
        display: grid;
        width: 1200px;
        height: 630px;
        grid-template-columns: 1.08fr 0.92fr;
        overflow: hidden;
        background: linear-gradient(135deg, #fafaf6 0%, #f3f4ef 58%, #e9ebe5 100%);
        isolation: isolate;
      }
      .card::before, .card::after { position: absolute; z-index: -1; border: 1px solid rgba(104, 111, 108, .16); border-radius: 50%; content: ''; }
      .card::before { width: 560px; height: 560px; top: -280px; right: -80px; }
      .card::after { width: 420px; height: 420px; right: 36px; bottom: -250px; }
      .copy { display: flex; min-width: 0; flex-direction: column; padding: 48px 12px 40px 56px; }
      .brand { display: flex; align-items: center; gap: 14px; }
      .seal {
        display: grid;
        width: 52px;
        height: 52px;
        place-items: center;
        border: 2px solid #b94a3e;
        border-radius: 10px;
        color: #b94a3e;
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
      }
      .brand strong { display: block; font-size: 28px; letter-spacing: 0.04em; line-height: 1.1; }
      .brand small { display: block; margin-top: 6px; color: #6d757c; font-size: 14px; font-weight: 700; letter-spacing: 0.12em; }
      .eyebrow { margin: 48px 0 10px; color: #c56a1c; font-size: 20px; font-weight: 700; letter-spacing: 0.08em; }
      h1 { margin: 0; font-size: 68px; font-weight: 700; letter-spacing: 0; line-height: 1.18; }
      h1 span { display: block; margin-top: 8px; color: #4e585f; }
      .case { max-width: 560px; margin: 22px 0 0; color: #4e585f; font-size: 24px; font-weight: 700; line-height: 1.45; }
      .rally { margin: 14px 0 0; color: #b94a3e; font-size: 22px; font-weight: 700; letter-spacing: 0.02em; }
      .site { display: flex; align-items: flex-end; gap: 14px; margin-top: auto; }
      .site strong { font-size: 36px; letter-spacing: 0; line-height: 1; }
      .site span { color: #6d757c; font-size: 16px; font-weight: 700; line-height: 1.35; }
      .figure {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        align-items: stretch;
        min-width: 0;
        padding: 22px 36px 24px 0;
      }
      .portrait-stage {
        position: relative;
        display: grid;
        place-items: center;
        overflow: hidden;
        min-height: 0;
      }
      .orbit {
        position: absolute;
        width: 320px;
        height: 320px;
        border: 2px solid rgba(109, 118, 115, .2);
        border-radius: 50%;
      }
      .orbit::before {
        position: absolute;
        inset: 16px;
        border: 1px solid rgba(209, 119, 42, .28);
        border-radius: 50%;
        content: '';
      }
      .portrait {
        position: relative;
        z-index: 1;
        width: 292px;
        height: 292px;
        object-fit: contain;
        object-position: center center;
        filter: drop-shadow(0 18px 24px rgba(35, 42, 45, .14));
      }
      .figure-bar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 20px;
        z-index: 2;
        margin-top: 0;
        padding: 16px 8px 0;
        background: #f0f1ec;
        border-top: 1px solid rgba(105, 112, 110, .22);
      }
      .state span { display: block; color: #6d757c; font-size: 16px; font-weight: 700; letter-spacing: 0.08em; }
      .state strong { display: block; margin-top: 2px; font-size: 42px; font-weight: 700; line-height: 1.1; }
      .state small { display: block; margin-top: 6px; color: #c56a1c; font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
      .qr { display: flex; align-items: center; gap: 14px; }
      .qr img {
        width: 188px;
        height: 188px;
        padding: 10px;
        border: 1px solid rgba(105, 112, 110, .28);
        border-radius: 14px;
        background: #fff;
      }
      .qr span { max-width: 92px; color: #4e585f; font-size: 18px; font-weight: 700; line-height: 1.4; }
      @media (min-width: 1800px) {
        .card { transform: scale(2); transform-origin: 0 0; }
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@700&display=block" rel="stylesheet" />
  </head>
  <body>
    <main class="card" data-card>
      <section class="copy">
        <div class="brand"><span class="seal" aria-hidden="true">相</span><div><strong>梁相</strong><small>LIANGXIANG</small></div></div>
        <p class="eyebrow">今日梁相 · {today.business_date}</p>
        <h1>众香成势，<span>梁子显相。</span></h1>
        <p class="case" data-card-case>{today.case_title}</p>
        <p class="rally">梁相还得梁人出！</p>
        <div class="site"><strong>liang.today</strong><span>DeepSeek Harness<br />社区玩法</span></div>
      </section>
      <section class="figure">
        <div class="portrait-stage">
          <div class="orbit" aria-hidden="true"></div>
          <img class="portrait" data-card-image src={image} alt={`${name}形相`} />
        </div>
        <div class="figure-bar">
          <div class="state"><span>今日显相</span><strong data-card-state>{name}</strong><small data-card-ratio>梁位 {ratio}</small></div>
          <div class="qr"><img src="/media/liang-today-qr.png" alt="liang.today 二维码" /><span>扫码查看今日梁相</span></div>
        </div>
      </section>
    </main>
    <script>
      const templates = {
        waiting: { name: '待开梁', image: '/artwork/waiting.png', ratio: '梁位 --', caseTitle: '今日梁案待开' },
        liang_gong: { name: '梁工', image: '/artwork/gong.png', ratio: '梁位 < 50%', caseTitle: '今日梁案 · 众香成势' },
        liang_zong: { name: '梁总', image: '/artwork/zong.png', ratio: '梁位 50%–70%', caseTitle: '今日梁案 · 众香成势' },
        liang_shen: { name: '梁神', image: '/artwork/shen.png', ratio: '梁位 70%–85%', caseTitle: '今日梁案 · 众香成势' },
        liang_sheng: { name: '梁圣', image: '/artwork/sheng.png', ratio: '梁位 85%–95%', caseTitle: '今日梁案 · 众香成势' },
        liang_zu: { name: '梁祖', image: '/artwork/zu.png', ratio: '梁位 ≥ 95%', caseTitle: '今日梁案 · 众香成势' },
      }
      const requested = new URLSearchParams(location.search).get('state')
      const card = requested && requested in templates ? templates[requested as keyof typeof templates] : null
      if (card) {
        const image = document.querySelector<HTMLImageElement>('[data-card-image]')
        const state = document.querySelector<HTMLElement>('[data-card-state]')
        const ratio = document.querySelector<HTMLElement>('[data-card-ratio]')
        const caseTitle = document.querySelector<HTMLElement>('[data-card-case]')
        if (image) { image.src = card.image; image.alt = `${card.name}形相` }
        if (state) state.textContent = card.name
        if (ratio) ratio.textContent = card.ratio
        if (caseTitle) caseTitle.textContent = card.caseTitle
      }
    </script>
  </body>
</html>
